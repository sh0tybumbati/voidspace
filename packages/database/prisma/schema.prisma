// Voidspace Database Schema
// Complete schema with 17 tables for democratic governance and transparent moderation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE TABLES
// ============================================================================

model User {
  id            String   @id @default(uuid())
  username      String   @unique @db.VarChar(50)
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  alignment     Int      @default(0)
  avatarUrl     String?  @map("avatar_url")
  bio           String?
  preferences   Json?
  isAdmin       Boolean  @default(false) @map("is_admin")
  isOver18      Boolean  @default(false) @map("is_over_18")
  banned        Boolean  @default(false)

  // Relations
  spaces              Space[]            @relation("SpaceCreator")
  posts               Post[]             @relation("PostAuthor")
  comments            Comment[]          @relation("CommentAuthor")
  votes               Vote[]
  subscriptions       Subscription[]
  moderatorRoles      Moderator[]        @relation("ModeratorUser")
  modActions          ModAction[]        @relation("ModActionModerator")
  modActionsReversed  ModAction[]        @relation("ModActionReverser")
  adminActions        AdminAction[]
  bansIssued          Ban[]              @relation("BanIssuer")
  bansReceived        Ban[]              @relation("BanReceiver")
  appeals             Appeal[]           @relation("AppealUser")
  appealsReviewed     Appeal[]           @relation("AppealReviewer")
  modElections        ModElection[]      @relation("ElectionCandidate")
  electionVotes       ElectionVote[]
  reports             Report[]           @relation("ReportReporter")
  reportsReviewed     Report[]           @relation("ReportReviewer")
  postsRemoved        Post[]             @relation("PostRemover")
  commentsRemoved     Comment[]          @relation("CommentRemover")
  moderatorsAdded     Moderator[]        @relation("ModeratorAdder")
  savedPosts          SavedPost[]
  savedComments       SavedComment[]

  @@index([username])
  @@index([email])
  @@map("users")
}

model Space {
  id               String   @id @default(uuid())
  name             String   @unique @db.VarChar(50)
  displayName      String   @map("display_name") @db.VarChar(100)
  description      String?
  createdAt        DateTime @default(now()) @map("created_at")
  creatorId        String   @map("creator_id")
  subscriberCount  Int      @default(0) @map("subscriber_count")
  rules            Json?
  sidebarContent   String?  @map("sidebar_content")
  isNsfw           Boolean  @default(false) @map("is_nsfw")
  nsfwType         String?  @map("nsfw_type") @db.VarChar(20) // 'none', 'partial', 'full'
  adEnabled        Boolean  @default(false) @map("ad_enabled")

  // Relations
  creator         User             @relation("SpaceCreator", fields: [creatorId], references: [id])
  posts           Post[]
  subscriptions   Subscription[]
  moderators      Moderator[]
  modActions      ModAction[]
  bans            Ban[]
  appeals         Appeal[]
  modElections    ModElection[]
  communityVotes  CommunityVote[]
  reports         Report[]
  flairs          Flair[]

  @@index([name])
  @@index([createdAt])
  @@map("spaces")
}

model Post {
  id             String    @id @default(uuid())
  spaceId        String    @map("space_id")
  authorId       String    @map("author_id")
  title          String    @db.VarChar(300)
  content        String?
  postType       String    @map("post_type") @db.VarChar(20) // 'text', 'link', 'image', 'video'
  url            String?
  flairId        String?   @map("flair_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  editedAt       DateTime? @map("edited_at")
  voteScore      Int       @default(0) @map("vote_score")
  hotScore       Float     @default(0) @map("hot_score")
  commentCount   Int       @default(0) @map("comment_count")
  isNsfw         Boolean   @default(false) @map("is_nsfw")
  isPinned       Boolean   @default(false) @map("is_pinned")
  removed        Boolean   @default(false)
  removedBy      String?   @map("removed_by")
  removalReason  String?   @map("removal_reason")

  // Relations
  space        Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author       User        @relation("PostAuthor", fields: [authorId], references: [id])
  remover      User?       @relation("PostRemover", fields: [removedBy], references: [id])
  flair        Flair?      @relation(fields: [flairId], references: [id], onDelete: SetNull)
  comments     Comment[]
  savedBy      SavedPost[]

  @@index([spaceId, createdAt])
  @@index([spaceId, hotScore])
  @@index([authorId])
  @@index([removed])
  @@index([flairId])
  @@map("posts")
}

model Comment {
  id              String    @id @default(uuid())
  postId          String    @map("post_id")
  parentCommentId String?   @map("parent_comment_id")
  authorId        String    @map("author_id")
  content         String
  imageUrl        String?   @map("image_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  editedAt        DateTime? @map("edited_at")
  voteScore       Int       @default(0) @map("vote_score")
  depthLevel      Int       @default(0) @map("depth_level")
  removed         Boolean   @default(false)
  removedBy       String?   @map("removed_by")
  removalReason   String?   @map("removal_reason")

  // Relations
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentComment Comment?       @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  author        User           @relation("CommentAuthor", fields: [authorId], references: [id])
  remover       User?          @relation("CommentRemover", fields: [removedBy], references: [id])
  replies       Comment[]      @relation("CommentReplies")
  savedBy       SavedComment[]

  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@index([authorId])
  @@map("comments")
}

model Vote {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetId   String   @map("target_id")
  targetType String   @map("target_type") @db.VarChar(20) // 'post' or 'comment'
  voteValue  Int      @map("vote_value") // 1 or -1
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user    User     @relation(fields: [userId], references: [id])

  @@unique([userId, targetId, targetType])
  @@index([targetId, targetType])
  @@map("votes")
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  spaceId   String   @map("space_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id])
  space Space @relation(fields: [spaceId], references: [id])

  @@unique([userId, spaceId])
  @@index([userId])
  @@index([spaceId])
  @@map("subscriptions")
}

// ============================================================================
// MODERATION & GOVERNANCE TABLES
// ============================================================================

model Moderator {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  spaceId     String   @map("space_id")
  permissions Json     // Granular permissions object
  addedAt     DateTime @default(now()) @map("added_at")
  addedBy     String   @map("added_by")
  isFounder   Boolean  @default(false) @map("is_founder")

  // Relations
  user    User  @relation("ModeratorUser", fields: [userId], references: [id])
  space   Space @relation(fields: [spaceId], references: [id])
  addedByUser User @relation("ModeratorAdder", fields: [addedBy], references: [id])

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@index([userId])
  @@map("moderators")
}

model ModAction {
  id         String    @id @default(uuid())
  modId      String    @map("mod_id")
  spaceId    String    @map("space_id")
  actionType String    @map("action_type") @db.VarChar(50) // 'remove_post', 'remove_comment', 'ban_user', etc.
  targetId   String    @map("target_id")
  targetType String    @map("target_type") @db.VarChar(20) // 'post', 'comment', 'user'
  reason     String    // REQUIRED
  createdAt  DateTime  @default(now()) @map("created_at")
  reversedBy String?   @map("reversed_by")
  reversedAt DateTime? @map("reversed_at")

  // Relations
  mod       User   @relation("ModActionModerator", fields: [modId], references: [id])
  space     Space  @relation(fields: [spaceId], references: [id])
  reverser  User?  @relation("ModActionReverser", fields: [reversedBy], references: [id])
  appeals   Appeal[]

  @@index([spaceId, createdAt])
  @@index([modId])
  @@index([targetId, targetType])
  @@map("mod_actions")
}

model AdminAction {
  id            String   @id @default(uuid())
  adminId       String   @map("admin_id")
  actionType    String   @map("action_type") @db.VarChar(50) // 'remove_mod', 'legal_takedown', 'ban_user'
  targetId      String   @map("target_id")
  targetType    String   @map("target_type") @db.VarChar(20)
  justification String   // PUBLIC and REQUIRED
  evidence      String?
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  admin User @relation(fields: [adminId], references: [id])

  @@index([createdAt])
  @@map("admin_actions")
}

model Ban {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  spaceId   String?   @map("space_id") // NULL for site-wide ban
  bannedBy  String    @map("banned_by")
  reason    String    // REQUIRED
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at") // NULL for permanent
  isActive  Boolean   @default(true) @map("is_active")

  // Relations
  user     User   @relation("BanReceiver", fields: [userId], references: [id])
  space    Space? @relation(fields: [spaceId], references: [id])
  bannedByUser User @relation("BanIssuer", fields: [bannedBy], references: [id])

  @@index([userId, spaceId])
  @@index([expiresAt])
  @@map("bans")
}

model Appeal {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  spaceId      String    @map("space_id")
  modActionId  String    @map("mod_action_id")
  reason       String
  status       String    @default("pending") @db.VarChar(20) // 'pending', 'approved', 'denied'
  reviewedBy   String?   @map("reviewed_by")
  reviewerNotes String?  @map("reviewer_notes")
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")

  // Relations
  user      User      @relation("AppealUser", fields: [userId], references: [id])
  space     Space     @relation(fields: [spaceId], references: [id])
  modAction ModAction @relation(fields: [modActionId], references: [id])
  reviewer  User?     @relation("AppealReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([userId])
  @@map("appeals")
}

model ModElection {
  id            String   @id @default(uuid())
  spaceId       String   @map("space_id")
  candidateId   String   @map("candidate_id")
  electionType  String   @map("election_type") @db.VarChar(20) // 'add_mod' or 'remove_mod'
  nominationDate DateTime @default(now()) @map("nomination_date")
  electionStart DateTime @map("election_start")
  electionEnd   DateTime @map("election_end")
  votesFor      Int      @default(0) @map("votes_for")
  votesAgainst  Int      @default(0) @map("votes_against")
  status        String   @default("active") @db.VarChar(20) // 'active', 'passed', 'failed'

  // Relations
  space       Space           @relation(fields: [spaceId], references: [id])
  candidate   User            @relation("ElectionCandidate", fields: [candidateId], references: [id])
  votes       ElectionVote[]

  @@index([spaceId, status])
  @@map("mod_elections")
}

model ElectionVote {
  id         String   @id @default(uuid())
  electionId String   @map("election_id")
  userId     String   @map("user_id")
  vote       Boolean  // true = for, false = against
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  election ModElection @relation(fields: [electionId], references: [id])
  user     User        @relation(fields: [userId], references: [id])

  @@unique([electionId, userId])
  @@map("election_votes")
}

model CommunityVote {
  id          String    @id @default(uuid())
  spaceId     String    @map("space_id")
  voteType    String    @map("vote_type") @db.VarChar(50) // 'enable_ads', 'change_rules', 'go_private'
  proposal    String
  createdAt   DateTime  @default(now()) @map("created_at")
  endsAt      DateTime  @map("ends_at")
  votesFor    Int       @default(0) @map("votes_for")
  votesAgainst Int      @default(0) @map("votes_against")
  status      String    @default("active") @db.VarChar(20)
  result      Json?

  // Relations
  space Space @relation(fields: [spaceId], references: [id])

  @@index([spaceId, status])
  @@map("community_votes")
}

model Report {
  id         String    @id @default(uuid())
  reporterId String    @map("reporter_id")
  targetId   String    @map("target_id")
  targetType String    @map("target_type") @db.VarChar(20) // 'post', 'comment', 'user'
  reason     String
  status     String    @default("pending") @db.VarChar(20)
  reviewedBy String?   @map("reviewed_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  spaceId    String?   @map("space_id")

  // Relations
  reporter User   @relation("ReportReporter", fields: [reporterId], references: [id])
  reviewer User?  @relation("ReportReviewer", fields: [reviewedBy], references: [id])
  space    Space? @relation(fields: [spaceId], references: [id])

  @@index([status])
  @@index([targetId, targetType])
  @@map("reports")
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
  @@index([userId])
  @@map("saved_posts")
}

model SavedComment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  commentId String   @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  comment Comment @relation(fields: [commentId], references: [id])

  @@unique([userId, commentId])
  @@index([userId])
  @@map("saved_comments")
}

model Flair {
  id        String   @id @default(uuid())
  spaceId   String   @map("space_id")
  text      String   @db.VarChar(30)
  textColor String   @map("text_color") @db.VarChar(7) // hex color like #FFFFFF
  bgColor   String   @map("bg_color") @db.VarChar(7)    // hex color like #0000FF
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([spaceId])
  @@map("flairs")
}

// ============================================================================
// LEGAL & COMPLIANCE TABLES
// ============================================================================

model LegalNotice {
  id                  String   @id @default(uuid())
  noticeType          String   @map("notice_type") @db.VarChar(50) // 'dmca', 'court_order', 'government_request'
  affectedContentType String?  @map("affected_content_type") @db.VarChar(20)
  affectedContentId   String?  @map("affected_content_id")
  jurisdiction        String   @db.VarChar(100)
  dateReceived        DateTime @map("date_received")
  actionTaken         String   @map("action_taken")
  publicSummary       String?  @map("public_summary")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([dateReceived])
  @@map("legal_notices")
}

model TransparencyCanary {
  id         String   @id @default(uuid())
  statement  String
  validUntil DateTime @map("valid_until")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([validUntil])
  @@map("transparency_canary")
}
