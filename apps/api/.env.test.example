# Copy to .env.test. Tests wipe this database between runs, so it must be a separate database,
# and its name must contain "_test" or the test helpers refuse to run.
NODE_ENV=test
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/voidspace_test?schema=public"
JWT_SECRET="test-secret-not-for-production"
FRONTEND_URL=http://localhost:3200
