# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/voidspace?schema=public"

# Authentication
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRY="7d"

# Public-site safety (see docs/deployment.md)
# REQUIRE_EMAIL_VERIFICATION=1   posting, voting and creating spaces need a verified email (needs SMTP_*)
# TRUST_PROXY=1                  set when behind a tunnel or reverse proxy, so rate limits see real addresses
# ALLOW_LAN_ORIGINS=1            home installs only: also accept requests from private-network addresses

# Uploads: stored in UPLOAD_DIR by default (served at /uploads). Fill in S3_* to use object storage instead.
# UPLOAD_DIR="./uploads"

# File Storage (S3-compatible)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="voidspace-uploads"
S3_REGION="auto"
CDN_URL=""

# Email (SMTP for notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@voidspace.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Admin
ADMIN_EMAIL=""
