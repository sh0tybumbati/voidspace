# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/voidspace?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRY="7d"

# File Storage (S3-compatible)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="voidspace-uploads"
S3_REGION="auto"
CDN_URL=""

# Email (SMTP for notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@voidspace.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Admin
ADMIN_EMAIL=""
